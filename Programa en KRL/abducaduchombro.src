&ACCESS RVP1
&REL 95
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\fisioterapia\hombroflex
DEF abducaduchombro( )

;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD
posic2()
loop

;FOLD WAIT FOR ( IN 25 '' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:25, 7:, 9:
WAIT FOR  ( $IN[25] ) 
;ENDFOLD

;FOLD CIRC P1 P2 CONT Vel=2 m/s CPDAT2 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P1, 3:P2, 4:C_DIS C_DIS, 6:2, 8:CPDAT2
$BWDSTART=FALSE
LDAT_ACT=LCPDAT2
FDAT_ACT=FP2
BAS(#CP_PARAMS,2)
CIRC XP1, XP2 C_DIS C_DIS
;ENDFOLD
;FOLD CIRC P3 P4 CONT Vel=2 m/s CPDAT3 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P3, 3:P4, 4:C_DIS C_DIS, 6:2, 8:CPDAT3
$BWDSTART=FALSE
LDAT_ACT=LCPDAT3
FDAT_ACT=FP4
BAS(#CP_PARAMS,2)
CIRC XP3, XP4 C_DIS C_DIS
;ENDFOLD
;FOLD CIRC P5 P6 CONT Vel=2 m/s CPDAT4 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P5, 3:P6, 4:C_DIS C_DIS, 6:2, 8:CPDAT4
$BWDSTART=FALSE
LDAT_ACT=LCPDAT4
FDAT_ACT=FP6
BAS(#CP_PARAMS,2)
CIRC XP5, XP6 C_DIS C_DIS
;ENDFOLD
;FOLD CIRC P7 P8 CONT Vel=2 m/s CPDAT5 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P7, 3:P8, 4:C_DIS C_DIS, 6:2, 8:CPDAT5
$BWDSTART=FALSE
LDAT_ACT=LCPDAT5
FDAT_ACT=FP8
BAS(#CP_PARAMS,2)
CIRC XP7, XP8 C_DIS C_DIS
;ENDFOLD
;FOLD CIRC P9 P10 CONT Vel=2 m/s CPDAT6 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P9, 3:P10, 4:C_DIS C_DIS, 6:2, 8:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FP10
BAS(#CP_PARAMS,2)
CIRC XP9, XP10 C_DIS C_DIS
;ENDFOLD
;FOLD CIRC P11 P12 CONT Vel=2 m/s CPDAT7 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P11, 3:P12, 4:C_DIS C_DIS, 6:2, 8:CPDAT7
$BWDSTART=FALSE
LDAT_ACT=LCPDAT7
FDAT_ACT=FP12
BAS(#CP_PARAMS,2)
CIRC XP11, XP12 C_DIS C_DIS
;ENDFOLD
;FOLD CIRC P13 P14 CONT Vel=2 m/s CPDAT8 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P13, 3:P14, 4:C_DIS C_DIS, 6:2, 8:CPDAT8
$BWDSTART=FALSE
LDAT_ACT=LCPDAT8
FDAT_ACT=FP14
