&ACCESS RVO1
&REL 40
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\fisioterapia\hombroflex
DEF extflexhombro( )


;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD
posic()

loop
;FOLD WAIT FOR ( IN 25 '' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:25, 7:, 9:
WAIT FOR  ( $IN[25] ) 
;ENDFOLD
;FOLD CIRC P1 P2 CONT Vel=2 m/s CPDAT1 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P1, 3:P2, 4:C_DIS C_DIS, 6:2, 8:CPDAT1
$BWDSTART=FALSE
LDAT_ACT=LCPDAT1
FDAT_ACT=FP2
BAS(#CP_PARAMS,2)
CIRC XP1, XP2 C_DIS C_DIS
;ENDFOLD
;FOLD CIRC P3 P4 CONT Vel=2 m/s CPDAT2 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P3, 3:P4, 4:C_DIS C_DIS, 6:2, 8:CPDAT2
$BWDSTART=FALSE
LDAT_ACT=LCPDAT2
FDAT_ACT=FP4
BAS(#CP_PARAMS,2)
CIRC XP3, XP4 C_DIS C_DIS
;ENDFOLD
;FOLD CIRC P6 P7 CONT Vel=2 m/s CPDAT3 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P6, 3:P7, 4:C_DIS C_DIS, 6:2, 8:CPDAT3
$BWDSTART=FALSE
LDAT_ACT=LCPDAT3
FDAT_ACT=FP7
BAS(#CP_PARAMS,2)
CIRC XP6, XP7 C_DIS C_DIS
;ENDFOLD
;FOLD CIRC P13 P14 CONT Vel=2 m/s CPDAT6 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P13, 3:P14, 4:C_DIS C_DIS, 6:2, 8:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FP14
BAS(#CP_PARAMS,2)
CIRC XP13, XP14 C_DIS C_DIS
;ENDFOLD
;FOLD LIN P21 Vel=2 m/s CPDAT9 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P21, 3:, 5:2, 7:CPDAT9
$BWDSTART=FALSE
LDAT_ACT=LCPDAT9
FDAT_ACT=FP21
BAS(#CP_PARAMS,2)
LIN XP21 
;ENDFOLD
;FOLD CIRC P22 P23 Vel=2 m/s CPDAT10 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P22, 3:P23, 4:, 6:2, 8:CPDAT10
$BWDSTART=FALSE
LDAT_ACT=LCPDAT10
FDAT_ACT=FP23
BAS(#CP_PARAMS,2)
CIRC XP22, XP23 
;ENDFOLD
;FOLD CIRC P24 P25 Vel=2 m/s CPDAT11 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P24, 3:P25, 4:, 6:2, 8:CPDAT11
$BWDSTART=FALSE
LDAT_ACT=LCPDAT11
FDAT_ACT=FP25
BAS(#CP_PARAMS,2)
CIRC XP24, XP25 
;ENDFOLD
;FOLD LIN P26 Vel=2 m/s CPDAT12 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VLIN,%P 1:LIN, 2:P26, 3:, 5:2, 7:CPDAT12
$BWDSTART=FALSE
LDAT_ACT=LCPDAT12
FDAT_ACT=FP26
BAS(#CP_PARAMS,2)
LIN XP26 
;ENDFOLD


IF ($IN[24]==TRUE) THEN

   
;FOLD WAIT Time=1 sec;%{PE}%R 8.3.48,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 3:1
WAIT SEC 1
;ENDFOLD

EXIT

ENDIF

endloop



;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

END
