&ACCESS RVO1
&REL 18
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
&PARAM DISKPATH = KRC:\R1\fisioterapia\hombroflex
DEF abaduc( )



;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3 
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD
posic3()
loop
;FOLD WAIT FOR ( IN 25 '' );%{PE}%R 8.3.48,%MKUKATPBASIS,%CEXT_WAIT_FOR,%VEXT_WAIT_FOR,%P 2:, 4:, 5:$IN, 6:25, 7:, 9:
WAIT FOR  ( $IN[25] ) 
;ENDFOLD

;FOLD CIRC P1 P2 Vel=2 m/s CPDAT1 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P1, 3:P2, 4:, 6:2, 8:CPDAT1
$BWDSTART=FALSE
LDAT_ACT=LCPDAT1
FDAT_ACT=FP2
BAS(#CP_PARAMS,2)
CIRC XP1, XP2 
;ENDFOLD

;FOLD CIRC P3 P4 Vel=2 m/s CPDAT2 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P3, 3:P4, 4:, 6:2, 8:CPDAT2
$BWDSTART=FALSE
LDAT_ACT=LCPDAT2
FDAT_ACT=FP4
BAS(#CP_PARAMS,2)
CIRC XP3, XP4 
;ENDFOLD

;FOLD CIRC P5 P6 Vel=2 m/s CPDAT3 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P5, 3:P6, 4:, 6:2, 8:CPDAT3
$BWDSTART=FALSE
LDAT_ACT=LCPDAT3
FDAT_ACT=FP6
BAS(#CP_PARAMS,2)
CIRC XP5, XP6 
;ENDFOLD
;FOLD CIRC P8 P9 Vel=2 m/s CPDAT4 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P8, 3:P9, 4:, 6:2, 8:CPDAT4
$BWDSTART=FALSE
LDAT_ACT=LCPDAT4
FDAT_ACT=FP9
BAS(#CP_PARAMS,2)
CIRC XP8, XP9 
;ENDFOLD
;FOLD CIRC P10 P11 Vel=2 m/s CPDAT5 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P10, 3:P11, 4:, 6:2, 8:CPDAT5
$BWDSTART=FALSE
LDAT_ACT=LCPDAT5
FDAT_ACT=FP11
BAS(#CP_PARAMS,2)
CIRC XP10, XP11 
;ENDFOLD
;FOLD CIRC P12 P13 Vel=2 m/s CPDAT6 Tool[1]:cami Base[0];%{PE}%R 8.3.48,%MKUKATPBASIS,%CMOVE,%VCIRC,%P 1:CIRC, 2:P12, 3:P13, 4:, 6:2, 8:CPDAT6
$BWDSTART=FALSE
LDAT_ACT=LCPDAT6
FDAT_ACT=FP13
BAS(#CP_PARAMS,2)
CIRC XP12, XP13 
;ENDFOLD

IF ($IN[24]==TRUE) THEN

   
;FOLD WAIT Time=1 sec;%{PE}%R 8.3.48,%MKUKATPBASIS,%CWAIT,%VWAIT,%P 3:1
WAIT SEC 1
;ENDFOLD

EXIT
ENDIF

endloop

;FOLD PTP HOME  Vel= 100 % DEFAULT;%{PE}%MKUKATPBASIS,%CMOVE,%VPTP,%P 1:PTP, 2:HOME, 3:, 5:100, 7:DEFAULT
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,100 )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

END
